@model ExpirationTracker.Models.Truck
@{
    ViewData["Title"] = "Edit Truck";
}

<h2 class="mb-4"><i class="bi bi-pencil-square me-2"></i>Edit Truck - #@Model.TruckNo</h2>

<div class="card shadow-sm data-entry-card" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            @await Html.PartialAsync("_TruckForm", Model)
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Documents.Any())
{
    <div class="card shadow-sm mt-3 data-entry-card" style="max-width:600px">
        <div class="card-body">
            <h5 class="card-title">Stored Documents</h5>
            <div class="list-group list-group-flush">
                @foreach (var document in Model.Documents.OrderBy(d => d.ExpirationType))
                {
                    <div class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <div class="fw-semibold">@document.ExpirationType</div>
                            <a asp-action="DownloadDocument" asp-route-id="@document.Id">@document.FileName</a>
                            <div class="small text-muted">@Math.Ceiling(document.FileSize / 1024d) KB</div>
                        </div>
                        <form asp-action="DeleteDocument" asp-route-id="@document.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
