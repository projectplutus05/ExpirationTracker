@model IEnumerable<ExpirationTracker.Models.Truck>
@{
    ViewData["Title"] = "Trucks";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-truck-front me-2"></i>Trucks</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add New</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Driver</th>
                        <th>Truck #</th>
                        <th>Make</th>
                        <th>Model</th>
                        <th>Year</th>
                        <th>VIN</th>
                        <th>DOT</th>
                        <th>Tag</th>
                        <th>IRP</th>
                        <th>Documents</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Driver?.DriverName</td>
                            <td>@item.TruckNo</td>
                            <td>@item.TruckMake?.Name</td>
                            <td>@item.Model</td>
                            <td>@item.ModelYear</td>
                            <td><small>@item.Vin</small></td>
                            <td>@Html.DateBadge(item.DotInspectionExpiry)</td>
                            <td>@Html.DateBadge(item.TruckTagExpiry)</td>
                            <td>@Html.DateBadge(item.IrpExpiry)</td>
                            <td>
                                @foreach (var document in item.Documents.OrderBy(d => d.ExpirationType))
                                {
                                    var icon = document.ExpirationType switch
                                    {
                                        "DOT" => "bi-clipboard2-check",
                                        "Tag" => "bi-tag",
                                        _ => "bi-file-earmark-text"
                                    };
                                    <a asp-action="DownloadDocument"
                                       asp-route-id="@document.Id"
                                       class="document-icon-link me-1"
                                       title="@document.ExpirationType document"
                                       aria-label="Download @document.ExpirationType document">
                                        <i class="bi @icon" aria-hidden="true"></i>
                                    </a>
                                }
                            </td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
