@model ExpirationTracker.Models.Truck
@{
    ViewData["Title"] = "Add Truck";
}

<h2 class="mb-4"><i class="bi bi-plus-square me-2"></i>Add Truck</h2>

<div class="card shadow-sm data-entry-card" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            @await Html.PartialAsync("_TruckForm", Model)
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
