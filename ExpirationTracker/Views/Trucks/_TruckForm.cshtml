@model ExpirationTracker.Models.Truck

<div class="mb-3 row">
    <label asp-for="DriverId" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <select asp-for="DriverId" class="form-select" asp-items="ViewBag.DriverId">
            <option value="">Select Driver</option>
        </select>
        <span asp-validation-for="DriverId" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="TruckNo" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="TruckNo" class="form-control" />
        <span asp-validation-for="TruckNo" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="TruckMakeId" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <select asp-for="TruckMakeId" class="form-select" asp-items="ViewBag.TruckMakeId">
            <option value="">Select Make</option>
        </select>
        <span asp-validation-for="TruckMakeId" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="Model" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="ModelYear" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="ModelYear" class="form-control" />
        <span asp-validation-for="ModelYear" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="Vin" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="Vin" class="form-control" />
        <span asp-validation-for="Vin" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="DotInspectionExpiry" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="DotInspectionExpiry" asp-format="{0:yyyy-MM-dd}" class="form-control date-picker" type="date" onclick="if (this.showPicker) this.showPicker()" />
        <span asp-validation-for="DotInspectionExpiry" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="TruckTagExpiry" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="TruckTagExpiry" asp-format="{0:yyyy-MM-dd}" class="form-control date-picker" type="date" onclick="if (this.showPicker) this.showPicker()" />
        <span asp-validation-for="TruckTagExpiry" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="IrpExpiry" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="IrpExpiry" asp-format="{0:yyyy-MM-dd}" class="form-control date-picker" type="date" onclick="if (this.showPicker) this.showPicker()" />
        <span asp-validation-for="IrpExpiry" class="text-danger"></span>
    </div>
</div>
