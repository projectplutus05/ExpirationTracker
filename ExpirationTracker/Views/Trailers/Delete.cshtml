@model ExpirationTracker.Models.Trailer
@{
    ViewData["Title"] = "Delete Trailer";
}

<h2 class="mb-4 text-danger"><i class="bi bi-trash me-2"></i>Delete Trailer</h2>

<div class="card border-danger shadow-sm" style="max-width:500px">
    <div class="card-body">
        <p>Are you sure you want to delete this record?</p>
        <dl class="row">
            <dt class="col-sm-5">Trailer #</dt><dd class="col-sm-7">@Model.TrailerNumber</dd>
            <dt class="col-sm-5">Assigned To</dt><dd class="col-sm-7">@Model.AssignedTo</dd>
            <dt class="col-sm-5">VIN</dt><dd class="col-sm-7">@Model.Vin</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
