@model IEnumerable<ExpirationTracker.Models.Trailer>
@{
    ViewData["Title"] = "Trailers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-truck me-2"></i>Trailers</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add New</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Assigned To</th>
                        <th>Trailer #</th>
                        <th>Headboard</th>
                        <th>Year</th>
                        <th>Make/Model</th>
                        <th>VIN</th>
                        <th>Tag #</th>
                        <th>Tag Expiry</th>
                        <th>Annual Inspection</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AssignedTo</td>
                            <td>@item.TrailerNumber</td>
                            <td>@(item.HasHeadboard ? "Yes" : "No")</td>
                            <td>@item.Year</td>
                            <td>@item.Make @item.Model</td>
                            <td><small>@item.Vin</small></td>
                            <td>@item.TagNumber</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.TagNotes))
                                {
                                    <span class="badge bg-info text-dark">@item.TagNotes</span>
                                }
                                else
                                {
                                    @Html.DateBadge(item.TagExpiry)
                                }
                            </td>
                            <td>@Html.DateBadge(item.AnnualInspExpiry)</td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
