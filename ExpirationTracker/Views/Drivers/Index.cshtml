@model IEnumerable<ExpirationTracker.Models.Driver>
@{
    ViewData["Title"] = "Drivers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-badge me-2"></i>Drivers</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add New</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Driver #</th>
                        <th>Driver Name</th>
                        <th>Physical</th>
                        <th>License</th>
                        <th>Documents</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DriverNumber</td>
                            <td>@item.DriverName</td>
                            <td>@Html.DateBadge(item.PhysicalExpiry)</td>
                            <td>@Html.DateBadge(item.LicenseExpiry)</td>
                            <td>
                                @foreach (var document in item.Documents.OrderBy(d => d.ExpirationType))
                                {
                                    var icon = document.ExpirationType == "License" ? "bi-person-vcard" : "bi-heart-pulse";
                                    <a asp-action="DownloadDocument"
                                       asp-route-id="@document.Id"
                                       class="document-icon-link me-1"
                                       title="@document.ExpirationType document"
                                       aria-label="Download @document.ExpirationType document">
                                        <i class="bi @icon" aria-hidden="true"></i>
                                    </a>
                                }
                            </td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
