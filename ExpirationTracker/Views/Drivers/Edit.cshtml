@model ExpirationTracker.Models.Driver
@{
    ViewData["Title"] = "Edit Driver";
}

<h2 class="mb-4"><i class="bi bi-pencil-square me-2"></i>Edit Driver — @Model.DriverName</h2>

<div class="card shadow-sm data-entry-card" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            @await Html.PartialAsync("_DriverForm", Model)
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
