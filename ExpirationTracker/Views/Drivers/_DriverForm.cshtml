@model ExpirationTracker.Models.Driver

<div class="mb-3 row">
    <label asp-for="DriverNumber" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="DriverNumber" class="form-control" />
        <span asp-validation-for="DriverNumber" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="DriverName" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="DriverName" class="form-control" />
        <span asp-validation-for="DriverName" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="PhysicalExpiry" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="PhysicalExpiry" asp-format="{0:yyyy-MM-dd}" class="form-control date-picker" type="date" onclick="if (this.showPicker) this.showPicker()" />
        <span asp-validation-for="PhysicalExpiry" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label for="physicalDocument" class="col-sm-4 col-form-label">Physical Document</label>
    <div class="col-sm-8">
        <label class="file-drop-zone" for="physicalDocument">
            <input id="physicalDocument" name="physicalDocument" class="file-drop-input" type="file" />
            <span class="file-drop-icon"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i></span>
            <span class="file-drop-text">Drop file here or browse</span>
            <span class="file-drop-name">No file selected</span>
        </label>
    </div>
</div>
<div class="mb-3 row">
    <label asp-for="LicenseExpiry" class="col-sm-4 col-form-label"></label>
    <div class="col-sm-8">
        <input asp-for="LicenseExpiry" asp-format="{0:yyyy-MM-dd}" class="form-control date-picker" type="date" onclick="if (this.showPicker) this.showPicker()" />
        <span asp-validation-for="LicenseExpiry" class="text-danger"></span>
    </div>
</div>
<div class="mb-3 row">
    <label for="licenseDocument" class="col-sm-4 col-form-label">License Document</label>
    <div class="col-sm-8">
        <label class="file-drop-zone" for="licenseDocument">
            <input id="licenseDocument" name="licenseDocument" class="file-drop-input" type="file" />
            <span class="file-drop-icon"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i></span>
            <span class="file-drop-text">Drop file here or browse</span>
            <span class="file-drop-name">No file selected</span>
        </label>
    </div>
</div>
