@model ExpirationTracker.Models.Driver
@{
    ViewData["Title"] = "Delete Driver";
}

<h2 class="mb-4 text-danger"><i class="bi bi-trash me-2"></i>Delete Driver</h2>

<div class="card border-danger shadow-sm" style="max-width:500px">
    <div class="card-body">
        <p>Are you sure you want to delete this record?</p>
        <dl class="row">
            <dt class="col-sm-4">Driver Name</dt><dd class="col-sm-8">@Model.DriverName</dd>
            <dt class="col-sm-4">Driver #</dt><dd class="col-sm-8">@Model.DriverNumber</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
